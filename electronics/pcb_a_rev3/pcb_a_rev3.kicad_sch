	(text "WARNING:\nPG is pulled high to VIN through a 550k resistor. \nGiven the 550k/10k ratio, this should not be a problem\nI = (5 − 3.3) / (550k + 10k) ≈ 3.036 µA\nV = I·10k ≈ 30mV gain"
		(exclude_from_sim no)
		(at 91.948 57.912 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 165 20 1)
			)
			(justify left)
		)
		(uuid "8dc1bbf0-a0a5-4d5b-b487-0aa6d6fc4bb0")
	)
	(text "WARNING:\nSince there isn't any level shifter for led data pins, some fine \ntuning is required in order to drive the leds from a \"3.3v\" source.\nThere isn't any formula for tuning with the OUT_S pin but using\n3.3k seems to boost the output to ~3.47v which is enough for my board"
		(exclude_from_sim no)
		(at 104.14 36.322 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 128 128 133 1)
			)
			(justify left)
		)
		(uuid "dbbddc73-41ca-42dc-9991-b50f04a88869")
	)
